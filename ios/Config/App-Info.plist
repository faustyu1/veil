<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app has no .lproj bundles — translations live in a code table
	  (Core/LocalizationTable.swift) so the SPM-based macOS build can share
	  them. Declaring the languages here is still needed: without it iOS
	  treats the app as English-only and hands back English for every string
	  the system draws itself (share sheet, photo picker, keyboard, paste),
	  which is what makes a screen look half-translated.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>zh</string>
		<string>es</string>
		<string>hi</string>
		<string>ar</string>
		<string>fr</string>
		<string>pt</string>
		<string>de</string>
		<string>ja</string>
		<string>id</string>
		<string>tr</string>
	</array>
</dict>
</plist>
